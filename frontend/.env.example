# Backend API URL (without trailing slash)
# Note: VITE_* values are exposed to the browser. Never store secrets here.
VITE_API_URL=http://localhost:8000

# Firebase Web Configuration (public client-side config)
VITE_FIREBASE_APIKEY=your_firebase_web_api_key

# Geoapify Geocoding API Key
VITE_GEOAPIKEY=your_geoapify_api_key

# Razorpay Key ID (Public key for client-side checkout)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
