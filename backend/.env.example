# Backend Server Configuration
PORT=8000
NODE_ENV=development

# Database
MONGODB_URL=mongodb://localhost:27017/vingo

# Authentication
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters

# Nodemailer (Gmail SMTP or other provider)
EMAIL=your_email@example.com
PASS=your_smtp_app_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Firebase Admin SDK (for Google OAuth ID token verification)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----
FIREBASE_CLIENT_EMAIL=your-firebase-service-account@your-project.iam.gserviceaccount.com

# CORS Allowed Origin (comma-separated or single URL; must be HTTPS in production)
ALLOWED_ORIGIN=http://localhost:5173

# Reverse proxy trust (comma-separated IPs/CIDRs of proxies you operate).
# Leave empty when the app receives traffic directly from clients.
# Never set this to a public range or to a value that trusts arbitrary peers.
TRUST_PROXY_CIDRS=

# Production cookie policy: lax, strict, or none (default: none).
# Cookies are always Secure and HttpOnly in production.
COOKIE_SAME_SITE=none

# Rate limiting (shared MongoDB-backed store).
# Development may use "memory"; production MUST use "mongo".
RATE_LIMIT_STORE=memory
# Required in production when RATE_LIMIT_STORE=mongo. Must be at least 32 characters
# and must not be a known placeholder (e.g. "changeme", "secret", "test").
RATE_LIMIT_KEY_SECRET=replace_with_a_secure_random_string_at_least_32_characters
# Optional. Defaults to "vingo:{NODE_ENV}".
RATE_LIMIT_KEY_PREFIX=
# Optional. Defaults to "rate_limit_counters".
RATE_LIMIT_MONGO_COLLECTION=
# Optional. Integer between 100 and 10000. Defaults to 2000.
RATE_LIMIT_MONGO_TIMEOUT_MS=
